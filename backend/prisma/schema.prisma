generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RefreshTokens {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  email                           String               @unique
  emailVerified                   Boolean              @default(false)
  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  // Pending email change: held until the new address is verified via email.
  pendingEmail           String?
  emailChangeToken       String?
  emailChangeTokenExpiresAt DateTime?

  password                        String
  refreshTokens                   RefreshTokens[]
  passwordResetTokens             PasswordResetToken[]

  profile Profile?
}

model Profile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name      String
  firstTime Boolean @default(true)
  // idDocument  String?

  approved     Boolean @default(false)
  approvedById String?

  role        Role?        @default(STUDENT)
  gender      Gender?
  dob         DateTime?
  ageCategory AgeCategory?
  nationality String?
  phone       String?

  parentOneName  String?
  parentOneEmail String?
  parentOnePhone String?

  churchId         String?
  church           Church? @relation("ChurchProfiles", fields: [churchId], references: [id])
  primaryForChurch Boolean @default(false)

  registrations Registration[]
  spouseOf      Registration[] @relation("RegistrationSpouse")

  notifications Notification[]
  requiredActionCompletions RequiredActionCompletion[]
}

model Church {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name    String
  country String
  state   String

  // primaryContactName String
  // primaryContactRole String
  // primaryContactEmail String
  // primaryContactNumber String

  members Profile[] @relation("ChurchProfiles")

  scholarshipPayments ScholarshipPayment[]
}

model Registration {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id])

  medications String[]
  allergies   String[]
  shirtSize   ShirtSize
  swimming    Boolean
  selfPay     Boolean
  room        String?
  group       String?
  // Leaders can belong to a group without other members seeing them in the
  // group member list. The assignment is kept, but the public event endpoint
  // filters these rows out of the group roster. Admins still see them.
  hiddenInGroup Boolean @default(false)

  // Event-wide permission to award/remove points for any points group.
  pointsMaster Boolean @default(false)

  spouseId             String?
  spouse               Profile?               @relation("RegistrationSpouse", fields: [spouseId], references: [id], onDelete: SetNull)
  primaryLeaderRole    String?
  secondaryLeaderRoles String[]

  mediaConsent       Boolean @default(false)
  swimmingPermission Boolean @default(false)
  emergencyName      String
  emergencyPhone     String
  notes              String?
  safeguardingDoc    String?

  parentVerified       Boolean   @default(false)
  parentToken          String?
  parentTokenExpiresAt DateTime?

  paid           Boolean
  earlyBird      Boolean @default(false)
  paymentMethod  PaymentMethod @default(STRIPE)
  paymentSession String?

  // Check-in state. `checkInVersion` is the optimistic-concurrency token used
  // by the check-in API so simultaneous staff/admins cannot overwrite each
  // other silently. Actor details live in CheckInLog.
  checkInStatus   CheckInStatus @default(PENDING)
  checkInStatusAt DateTime?
  checkInVersion  Int           @default(0)

  @@index([eventId, checkInStatus])
}

model Event {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventStatus    EventStatus @default(OPEN)
  startDate      DateTime
  endDate        DateTime
  name           String
  brief          String
  maxSignUps     Int
  location       String
  schedule       Json[]
  price          Int
  earlyBirdPrice Int?
  earlyBirdDate  DateTime?
  // Legacy events may have no automatic cutoff and stay open until manually closed.
  registrationCloseDate DateTime?
  groups         Int         @default(1)
  maxInGroup     Int         @default(1)
  room           Int         @default(1)
  maxInRoom      Int         @default(1)

  // Ordered room/group titles. Registration.room / Registration.group store the
  // title a person is assigned to, so these arrays are the source of truth for
  // which titles exist (and in what order). Every non-null assignment must
  // match one of these entries.
  roomNames      String[]    @default([])
  groupNames     String[]    @default([])

  registrations       Registration[]
  scholarshipPayments ScholarshipPayment[]

  requiredActions RequiredAction[]

  pointsGroups     PointsGroup[]
  pointsGroupSlots PointsGroupSlot[]
  pointsEntries    PointsEntry[]
  pointsPresets    PointsPreset[]
}

// Admin-created grouping of one or more plan groups. Each plan group can
// belong to at most one points group (enforced on PointsGroupSlot).
model PointsGroup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name String

  slots   PointsGroupSlot[]
  entries PointsEntry[]

  @@unique([eventId, name])
  @@index([eventId])
}

// Membership of a plan group (identified by its position in Event.groupNames)
// in a points group. Positional identity means renaming a plan group keeps the
// points group and its history intact.
model PointsGroupSlot {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  pointsGroupId String
  pointsGroup   PointsGroup @relation(fields: [pointsGroupId], references: [id], onDelete: Cascade)

  slotIndex Int

  @@unique([eventId, slotIndex])
  @@index([pointsGroupId])
}

// Append-only points log. A reason is required for every adjustment; entries
// are never edited or deleted.
model PointsEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  pointsGroupId String
  pointsGroup   PointsGroup @relation(fields: [pointsGroupId], references: [id], onDelete: Cascade)

  delta  Int
  reason String

  presetId String?
  preset   PointsPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  createdById   String
  createdByName String

  @@index([eventId, createdAt])
  @@index([pointsGroupId])
}

// Admin-managed quick-pick adjustments for points masters. `delta` sign
// decides whether the preset appears under "add" or "remove".
model PointsPreset {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label     String
  delta     Int
  reason    String
  sortOrder Int    @default(0)

  entries PointsEntry[]

  @@index([eventId])
}

model ScholarshipPayment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sessionId  String   @unique
  profileIds String[]
  paid       Boolean  @default(false)
  quantity   Int
  amount     Int
  currency   String   @default("aed")

  @@index([churchId, paid])
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Gender {
  MALE
  FEMALE
}

enum AgeCategory {
  JUNIOR
  SENIOR
}

enum Role {
  STUDENT
  LEADER
  ADMIN
}

enum PaymentMethod {
  STRIPE
  SELF
}

enum EventStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum CheckInStatus {
  PENDING
  CHECKED_IN
  NO_SHOW
}

enum LeaderRoleKind {
  PRIMARY
  SECONDARY
}

// Admin-managed volunteer roles. `key` is the stable value stored on
// Registration rows (primaryLeaderRole / secondaryLeaderRoles); `label` and
// `description` are safe to edit at any time.
model LeaderRole {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  key         String         @unique
  label       String
  description String         @default("")
  kind        LeaderRoleKind
  sortOrder   Int            @default(0)
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  link    String
  seen    Boolean @default(false)

  @@index([profileId, seen])
  @@index([profileId, createdAt])
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// Append-only check-in audit trail. Actor IDs are stored as scalars rather
// than relations so history survives profile/registration deletion.
model CheckInLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  registrationId String
  eventId        String
  profileId      String

  previousStatus CheckInStatus
  status         CheckInStatus

  // Which leader registration performed the action. Null for admins who are
  // not registered for the event.
  actorProfileId      String
  actorRegistrationId String?
  actorName           String
  actorIsAdmin        Boolean @default(false)

  @@index([registrationId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorProfileId])
}

enum RequiredActionType {
  DOCUMENT
  VIDEO
  FORM
}

enum RequiredActionAudience {
  ALL
  LEADERS
  STUDENTS
}

enum RequiredActionStatus {
  PENDING
  COMPLETED
}

model RequiredAction {
  id          String                 @id @default(uuid())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?

  eventId     String
  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type        RequiredActionType     @default(VIDEO)
  audience    RequiredActionAudience @default(ALL)
  title       String
  description String?

  // Type-specific payload (nullable so one table covers all three kinds):
  markdown    String? // DOCUMENT: md text to read + agree
  videoUrl    String? // VIDEO: direct mp4/webm link
  formFileUrl String? // FORM: template download URL

  createdById String

  completions RequiredActionCompletion[]

  @@index([eventId, audience])
}

model RequiredActionCompletion {
  // id doubles as the player's `videoWatchedId` for VIDEO actions
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  actionId        String
  action          RequiredAction       @relation(fields: [actionId], references: [id], onDelete: Cascade)

  profileId       String
  profile         Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status          RequiredActionStatus @default(PENDING)

  // VIDEO progress (cheat-proof unique seconds merged client-side)
  watchedSeconds  Float                @default(0)
  furthestSeconds Float                @default(0)
  lastPosition    Float                @default(0)
  duration        Float?
  completedAt     DateTime?

  @@unique([actionId, profileId])
  @@index([profileId, status])
}

// Global library of admin-uploaded videos (stored in uploads/videos, served by nginx).
// Required actions reference a row; the dropdown lists titles.
model VideoAsset {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  title        String
  url          String   @unique
  mimeType     String?
  sizeBytes    Int?

  uploadedById String

  @@index([createdAt])
}
