generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RefreshTokens {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  email                           String               @unique
  emailVerified                   Boolean              @default(false)
  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  // Pending email change: held until the new address is verified via email.
  pendingEmail           String?
  emailChangeToken       String?
  emailChangeTokenExpiresAt DateTime?

  password                        String
  refreshTokens                   RefreshTokens[]
  passwordResetTokens             PasswordResetToken[]

  profile Profile?
}

model Profile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name      String
  firstTime Boolean @default(true)
  // idDocument  String?

  approved     Boolean @default(false)
  approvedById String?

  role        Role?        @default(STUDENT)
  gender      Gender?
  dob         DateTime?
  ageCategory AgeCategory?
  nationality String?
  phone       String?

  parentOneName  String?
  parentOneEmail String?
  parentOnePhone String?

  churchId         String?
  church           Church? @relation("ChurchProfiles", fields: [churchId], references: [id])
  primaryForChurch Boolean @default(false)

  registrations Registration[]
  spouseOf      Registration[] @relation("RegistrationSpouse")

  notifications Notification[]
  requiredActionCompletions RequiredActionCompletion[]
}

model Church {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name    String
  country String
  state   String

  // primaryContactName String
  // primaryContactRole String
  // primaryContactEmail String
  // primaryContactNumber String

  members Profile[] @relation("ChurchProfiles")

  scholarshipPayments ScholarshipPayment[]
}

model Registration {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id])

  medications String[]
  allergies   String[]
  shirtSize   ShirtSize
  swimming    Boolean
  selfPay     Boolean
  room        String?
  group       String?

  spouseId             String?
  spouse               Profile?               @relation("RegistrationSpouse", fields: [spouseId], references: [id], onDelete: SetNull)
  primaryLeaderRole    PrimaryLeaderRoles?
  secondaryLeaderRoles SecondaryLeaderRoles[]

  mediaConsent       Boolean @default(false)
  swimmingPermission Boolean @default(false)
  emergencyName      String
  emergencyPhone     String
  notes              String?
  safeguardingDoc    String?

  parentVerified       Boolean   @default(false)
  parentToken          String?
  parentTokenExpiresAt DateTime?

  paid           Boolean
  earlyBird      Boolean @default(false)
  paymentMethod  PaymentMethod @default(STRIPE)
  paymentSession String?
}

model Event {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventStatus    EventStatus @default(OPEN)
  startDate      DateTime
  endDate        DateTime
  name           String
  brief          String
  maxSignUps     Int
  location       String
  schedule       Json[]
  price          Int
  earlyBirdPrice Int?
  earlyBirdDate  DateTime?
  // Legacy events may have no automatic cutoff and stay open until manually closed.
  registrationCloseDate DateTime?
  groups         Int         @default(1)
  maxInGroup     Int         @default(1)
  room           Int         @default(1)
  maxInRoom      Int         @default(1)

  // Ordered room/group titles. Registration.room / Registration.group store the
  // title a person is assigned to, so these arrays are the source of truth for
  // which titles exist (and in what order). Every non-null assignment must
  // match one of these entries.
  roomNames      String[]    @default([])
  groupNames     String[]    @default([])

  registrations       Registration[]
  scholarshipPayments ScholarshipPayment[]

  requiredActions RequiredAction[]
}

model ScholarshipPayment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sessionId  String   @unique
  profileIds String[]
  paid       Boolean  @default(false)
  quantity   Int
  amount     Int
  currency   String   @default("aed")

  @@index([churchId, paid])
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Gender {
  MALE
  FEMALE
}

enum AgeCategory {
  JUNIOR
  SENIOR
}

enum Role {
  STUDENT
  LEADER
  ADMIN
}

enum PaymentMethod {
  STRIPE
  SELF
}

enum EventStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum PrimaryLeaderRoles {
  SMALL_GROUP_LEADER
  SECURITY_TEAM
  TECH_TEAM
}

enum SecondaryLeaderRoles {
  FLOOR_LEADER
  GAME_STATION_LEADER
  COLOR_TEAM_LEADER
  MEDIA
  PRAYER_TEAM
  REGISTRATION
  MEDICAL_AND_SAFEGUARDING
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  link    String
  seen    Boolean @default(false)

  @@index([profileId, seen])
  @@index([profileId, createdAt])
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

enum RequiredActionType {
  DOCUMENT
  VIDEO
  FORM
}

enum RequiredActionAudience {
  ALL
  LEADERS
  STUDENTS
}

enum RequiredActionStatus {
  PENDING
  COMPLETED
}

model RequiredAction {
  id          String                 @id @default(uuid())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?

  eventId     String
  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type        RequiredActionType     @default(VIDEO)
  audience    RequiredActionAudience @default(ALL)
  title       String
  description String?

  // Type-specific payload (nullable so one table covers all three kinds):
  markdown    String? // DOCUMENT: md text to read + agree
  videoUrl    String? // VIDEO: direct mp4/webm link
  formFileUrl String? // FORM: template download URL

  createdById String

  completions RequiredActionCompletion[]

  @@index([eventId, audience])
}

model RequiredActionCompletion {
  // id doubles as the player's `videoWatchedId` for VIDEO actions
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  actionId        String
  action          RequiredAction       @relation(fields: [actionId], references: [id], onDelete: Cascade)

  profileId       String
  profile         Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status          RequiredActionStatus @default(PENDING)

  // VIDEO progress (cheat-proof unique seconds merged client-side)
  watchedSeconds  Float                @default(0)
  furthestSeconds Float                @default(0)
  lastPosition    Float                @default(0)
  duration        Float?
  completedAt     DateTime?

  @@unique([actionId, profileId])
  @@index([profileId, status])
}

// Global library of admin-uploaded videos (stored in uploads/videos, served by nginx).
// Required actions reference a row; the dropdown lists titles.
model VideoAsset {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  title        String
  url          String   @unique
  mimeType     String?
  sizeBytes    Int?

  uploadedById String

  @@index([createdAt])
}
