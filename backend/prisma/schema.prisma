generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RefreshTokens {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  email         String          @unique
  emailVerified Boolean         @default(false)
  emailVerificationToken String?
  emailVerificationTokenExpiresAt DateTime?
  password      String
  refreshTokens RefreshTokens[]

  profile Profile?
}

model Profile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name      String
  firstTime Boolean @default(true)
  // idDocument  String?

  approved     Boolean @default(false)
  approvedById String?

  role        Role?     @default(STUDENT)
  gender      Gender?
  dob         DateTime?
  nationality String?
  phone       String?

  parentOneName  String?
  parentOneEmail String?
  parentOnePhone String?

  churchId         String?
  church           Church? @relation("ChurchProfiles", fields: [churchId], references: [id])
  primaryForChurch Boolean @default(false)

  registrations Registration[]
  spouseOf      Registration[] @relation("RegistrationSpouse")

  notifications Notification[]
}

model Church {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name    String
  country String
  state   String

  // primaryContactName String
  // primaryContactRole String
  // primaryContactEmail String
  // primaryContactNumber String

  members Profile[] @relation("ChurchProfiles")

  scholarshipPayments ScholarshipPayment[]
}

model Registration {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id])

  medications String[]
  allergies   String[]
  shirtSize   ShirtSize
  swimming    Boolean
  selfPay     Boolean
  room        String?
  group       String?

  spouseId           String?
  spouse             Profile?            @relation("RegistrationSpouse", fields: [spouseId], references: [id], onDelete: SetNull)
  primaryLeaderRole  PrimaryLeaderRoles?
  secondaryLeaderRoles SecondaryLeaderRoles[]

  mediaConsent Boolean @default(false)
  swimmingPermission Boolean @default(false)
  emergencyName  String
  emergencyPhone String
  notes          String?
  safeguardingDoc String?

  parentVerified Boolean @default(false)
  parentToken String?
  parentTokenExpiresAt DateTime?

  paid           Boolean
  paymentSession String?
}

model Event {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventStatus    EventStatus @default(OPEN)
  startDate      DateTime
  endDate        DateTime
  name           String
  brief          String
  maxSignUps     Int
  location       String
  schedule       Json[]
  price          Int
  earlyBirdPrice Int?
  earlyBirdDate  DateTime?

  registrations Registration[]
  scholarshipPayments ScholarshipPayment[]
}

model ScholarshipPayment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sessionId  String   @unique
  profileIds String[]
  paid       Boolean  @default(false)
  quantity   Int
  amount     Int
  currency   String   @default("aed")

  @@index([churchId, paid])
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  STUDENT
  LEADER
  ADMIN
}

enum EventStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum PrimaryLeaderRoles {
  SMALL_GROUP_LEADER
  SECURITY_TEAM
  TECH_TEAM
}

enum SecondaryLeaderRoles {
  FLOOR_LEADER
  GAME_STATION_LEADER
  COLOR_TEAM_LEADER
  MEDIA
  PRAYER_TEAM
  REGISTRATION
  MEDICAL_AND_SAFEGUARDING
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  link    String
  seen    Boolean  @default(false)

  @@index([profileId, seen])
  @@index([profileId, createdAt])
}